#!/usr/bin/expect -f

proc abort_test {message} {
	puts stderr "offline network test failed: $message"
	catch {close}
	exit 1
}

foreach variable {
	MAKE_COMMAND TEST_TOPDIR QEMU SBI_FIRMWARE ROOT_IMAGE QEMU_LOG
	QEMU_CPUS QEMU_MEMORY
} {
	if {![info exists env($variable)] || $env($variable) eq ""} {
		puts stderr "missing environment variable: $variable"
		exit 1
	}
}

set timeout 60
if {[info exists env(QEMU_TIMEOUT)] && $env(QEMU_TIMEOUT) ne ""} {
	set timeout $env(QEMU_TIMEOUT)
}

log_file -noappend $env(QEMU_LOG)
set extra_opts "-object rng-random,id=rng0,filename=/dev/zero"
append extra_opts \
	" -device virtio-rng-device,rng=rng0,bus=virtio-mmio-bus.0"
set command [list \
	$env(MAKE_COMMAND) \
	--silent \
	--no-print-directory \
	-C $env(TEST_TOPDIR) \
	QEMU=$env(QEMU) \
	SBI_FIRMWARE=$env(SBI_FIRMWARE) \
	FS_IMG=$env(ROOT_IMAGE) \
	FAT_IMG= \
	CPUS=$env(QEMU_CPUS) \
	MEMORY=$env(QEMU_MEMORY) \
	ROOT_BUS=virtio-mmio-bus.1 \
	NET_BACKEND=socket \
	NET_OPTIONS=udp=127.0.0.1:19991,localaddr=127.0.0.1:19990 \
	NET_BUS=virtio-mmio-bus.2 \
	RNG_BACKEND= \
	QEMU_SNAPSHOT=1 \
	QEMU_EXTRA_OPTS=$extra_opts \
	QEMU_PREBUILT=1 \
	qemu]

spawn -noecho {*}$command
expect {
	-re {\[PANIC\]} { abort_test "kernel panic before shell startup" }
	-re {\r?\n# $} {}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before shell startup" }
}

send -- "/bin/network-runtime loopback\r"
expect {
	-re {\r?\nNETWORK_LOOPBACK_OK} {}
	-re {NETWORK_RUNTIME_FAIL[^\r\n]*} {
		abort_test "loopback test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in loopback test" }
	timeout { abort_test "loopback test timeout" }
	eof { abort_test "QEMU exited during loopback test" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after loopback test" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited after loopback test" }
}

send -- "echo NETWORK_OFFLINE_BOOT_OK\r"
expect {
	-re {\r?\nNETWORK_OFFLINE_BOOT_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in shell" }
	timeout { abort_test "shell command timeout" }
	eof { abort_test "QEMU exited in shell" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after shell command" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before final prompt" }
}

send -- "\001x"
expect {
	eof {}
	timeout { abort_test "QEMU exit timeout" }
}
