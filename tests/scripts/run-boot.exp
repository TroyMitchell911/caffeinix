#!/usr/bin/expect -f

proc abort_test {message} {
	puts stderr "OpenSBI boot test failed: $message"
	catch {send -- "\001x"}
	set saved_timeout $::timeout
	set ::timeout 5
	catch {expect eof}
	set ::timeout $saved_timeout
	catch {close}
	exit 1
}

proc abort_with_dump {message} {
	set saved_timeout $::timeout
	catch {send -- "\001b"}
	set ::timeout 5
	catch {expect -re {DEBUG_STATE_END}}
	set ::timeout $saved_timeout
	abort_test $message
}

foreach variable {
	MAKE_COMMAND TEST_TOPDIR QEMU SBI_FIRMWARE ROOT_IMAGE QEMU_LOG
	QEMU_CPUS QEMU_MEMORY
} {
	if {![info exists env($variable)] || $env($variable) eq ""} {
		puts stderr "missing environment variable: $variable"
		exit 1
	}
}

set timeout 60
if {[info exists env(QEMU_TIMEOUT)] && $env(QEMU_TIMEOUT) ne ""} {
	set timeout $env(QEMU_TIMEOUT)
}
set pressure_iterations 1
if {[info exists env(DYNAMIC_PRESSURE_ITERATIONS)] &&
    $env(DYNAMIC_PRESSURE_ITERATIONS) ne ""} {
	set pressure_iterations $env(DYNAMIC_PRESSURE_ITERATIONS)
}

log_file -noappend $env(QEMU_LOG)
set command [list \
	$env(MAKE_COMMAND) \
	--silent \
	--no-print-directory \
	-C $env(TEST_TOPDIR) \
	QEMU=$env(QEMU) \
	SBI_FIRMWARE=$env(SBI_FIRMWARE) \
	FS_IMG=$env(ROOT_IMAGE) \
	FAT_IMG= \
	CPUS=$env(QEMU_CPUS) \
	MEMORY=$env(QEMU_MEMORY) \
	ROOT_BUS=virtio-mmio-bus.0 \
	NET_BACKEND= \
	NET_OPTIONS= \
	QEMU_SNAPSHOT=1 \
	QEMU_EXTRA_OPTS= \
	QEMU_PREBUILT=1 \
	qemu]

spawn -noecho {*}$command
expect {
	-re {\[PANIC\]} { abort_test "kernel panic before shell startup" }
	-re {\r?\n# $} {}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before shell startup" }
}

send -- "/bin/dynamic-hello\r"
expect {
	-re {\r?\nDYNAMIC_HELLO_OK} {}
	-re {not found|Bad system call|DYNAMIC_RUNTIME_FAIL} {
		abort_test "dynamic musl hello failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in dynamic musl hello" }
	timeout { abort_test "dynamic musl hello timeout" }
	eof { abort_test "QEMU exited during dynamic musl hello" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after dynamic musl hello" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited after dynamic musl hello" }
}

send -- "/bin/dynamic-runtime pressure $pressure_iterations\r"
expect {
	-re {\r?\nDYNAMIC_EXEC_PRESSURE_OK} {}
	-re {DYNAMIC_RUNTIME_FAIL[^\r\n]*} {
		abort_test "dynamic exec pressure test failed"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in dynamic exec pressure test"
	}
	timeout { abort_with_dump "dynamic exec pressure test timeout" }
	eof { abort_test "QEMU exited during dynamic exec pressure test" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} {
		abort_test "kernel panic after dynamic exec pressure test"
	}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited after dynamic exec pressure test" }
}

send -- "/bin/scheduler-runtime smoke\r"
expect {
	-re {\r?\nSCHED_SMOKE_OK} {}
	-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "scheduler smoke test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in scheduler smoke test" }
	timeout { abort_test "scheduler smoke test timeout" }
	eof { abort_test "QEMU exited during scheduler smoke test" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after scheduler smoke test" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before final shell prompt" }
}

send -- "/bin/network-runtime loopback\r"
expect {
	-re {\r?\nNETWORK_LOOPBACK_OK} {}
	-re {NETWORK_RUNTIME_FAIL[^\r\n]*} {
		abort_test "network loopback test reported failure"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in network loopback test"
	}
	timeout { abort_test "network loopback test timeout" }
	eof { abort_test "QEMU exited during network loopback test" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} {
		abort_test "kernel panic after network loopback test"
	}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited after network loopback test" }
}

if {$env(QEMU_CPUS) == 1} {
	send -- "/bin/scheduler-runtime fairness\r"
	expect {
		-re {\r?\nSCHED_CFS_FAIR_OK} {}
		-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
			abort_test "CFS fairness test reported failure"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in CFS fairness test"
		}
		timeout { abort_test "CFS fairness test timeout" }
		eof { abort_test "QEMU exited during CFS fairness test" }
	}
	expect {
		-re {\r?\n# $} {}
		-re {\[PANIC\]} {
			abort_test "kernel panic after CFS fairness test"
		}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited after CFS fairness test" }
	}
}

send -- "echo OPENSBI_BOOT_OK\r"
expect {
	-re {\r?\nOPENSBI_BOOT_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox shell" }
	timeout { abort_test "BusyBox command timeout" }
	eof { abort_test "QEMU exited in BusyBox shell" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after BusyBox command" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before final shell prompt" }
}

send -- "\001x"
expect {
	eof {}
	timeout { abort_test "QEMU exit timeout" }
}
