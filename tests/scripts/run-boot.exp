if {$reclaim_test == 1} {
	send -- "/bin/vm-runtime reclaim\r"
	expect {
		-re {\r?\nVM_RECLAIM_OK} {}
		-re {VM_RUNTIME_FAIL[^\r\n]*} {
			abort_test "clean-page reclaim test reported failure"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in clean-page reclaim test"
		}
		timeout { abort_with_dump "clean-page reclaim test timeout" }
		eof { abort_test "QEMU exited during clean-page reclaim test" }
	}
	expect {
		-re {\r?\n# $} {}
		-re {\[PANIC\]} {
			abort_test "kernel panic after clean-page reclaim test"
		}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited after clean-page reclaim test" }
	}
}

if {$env(QEMU_CPUS) == 1} {
	send -- "/bin/scheduler-runtime fairness\r"
	expect {
		-re {\r?\nSCHED_CFS_FAIR_OK} {}
		-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
			abort_test "CFS fairness test reported failure"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in CFS fairness test"
		}
		timeout { abort_test "CFS fairness test timeout" }
		eof { abort_test "QEMU exited during CFS fairness test" }
	}
	expect {
		-re {\r?\n# $} {}
		-re {\[PANIC\]} {
			abort_test "kernel panic after CFS fairness test"
		}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited after CFS fairness test" }
	}
}

send -- "echo OPENSBI_BOOT_OK\r"
expect {
	-re {\r?\nOPENSBI_BOOT_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox shell" }
	timeout { abort_test "BusyBox command timeout" }
	eof { abort_test "QEMU exited in BusyBox shell" }
}
expect {
	-re {\r?\n# $} {}
	-re {\[PANIC\]} { abort_test "kernel panic after BusyBox command" }
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before final shell prompt" }
}

send -- "\001x"
expect {
	eof {}
	timeout { abort_test "QEMU exit timeout" }
}
