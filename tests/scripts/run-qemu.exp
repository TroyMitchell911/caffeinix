	-re {\r?\nBUSYBOX_CTRL_C_STATUS=130} {}
	-re {\[PANIC\]} { abort_test "kernel panic after prompt Ctrl-C" }
	timeout { abort_test "BusyBox prompt Ctrl-C status timeout" }
	eof { abort_test "QEMU exited after prompt Ctrl-C" }
}
expect_prompt
send -- "if \[ ! -e /tmp/busybox-ctrl-c \]; then "
send -- "echo BUSYBOX_CTRL_C_OK; else echo BUSYBOX_CTRL_C_BAD; fi\r"
expect {
	-re {\r?\nBUSYBOX_CTRL_C_OK} {}
	-re {\r?\nBUSYBOX_CTRL_C_BAD} {
		abort_test "BusyBox executed the cancelled command"
	}
	-re {\[PANIC\]} { abort_test "kernel panic after cancelled command" }
	timeout { abort_test "BusyBox cancelled command check timeout" }
	eof { abort_test "QEMU exited after cancelled command" }
}
expect_prompt

