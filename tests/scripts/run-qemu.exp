	-re {FILE_ADMIN_RUNTIME_FAIL[^\r\n]*} {
		abort_test "file administration test reported failure"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in file administration test"
	}
	timeout { abort_with_dump "file administration test timeout" }
	eof { abort_test "QEMU exited during file administration test" }
}
expect_prompt

send -- "/bin/mount-runtime\r"
expect {
	-re {\r?\nMOUNT_RUNTIME_OK} {}
	-re {MOUNT_RUNTIME_FAIL[^\r\n]*} {
		abort_test "filesystem mount lifecycle test reported failure"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in filesystem mount lifecycle test"
	}
	timeout { abort_with_dump "filesystem mount lifecycle test timeout" }
	eof { abort_test "QEMU exited during filesystem mount lifecycle test" }
}
