expect {
	-re {JOB_CONTINUED} {}
	-re {\[PANIC\]} { abort_test "kernel panic while foregrounding job" }
	timeout { abort_test "foreground resume timeout" }
	eof { abort_test "QEMU exited while foregrounding job" }
}
after 100
send -- "\003"
expect_prompt
send -- "echo JOB_FG_STATUS=\$?\r"
expect {
	-re {\r?\nJOB_FG_STATUS=130} {}
	-re {\[PANIC\]} { abort_test "kernel panic after resumed job Ctrl-C" }
	timeout { abort_test "resumed job Ctrl-C status timeout" }
	eof { abort_test "QEMU exited after resumed job Ctrl-C" }
}
expect_prompt

send -- "/bin/job-control-runtime read &\r"
expect {
	-re {JOB_BACKGROUND_READ_READY} {}
	-re {JOB_CONTROL_FAIL[^\r\n]*} {
		abort_test "background terminal reader setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in background reader" }
	timeout { abort_test "background reader setup timeout" }
	eof { abort_test "QEMU exited during background reader setup" }
}
after 250
send -- "jobs\r"
expect {
	-re {Stopped \(tty input\)[^\r\n]*job-control-runtime read} {}
	-re {Running[^\r\n]*job-control-runtime read} {
		abort_test "background terminal read did not stop"
	}
	-re {\[PANIC\]} { abort_test "kernel panic after background read" }
	timeout { abort_test "background reader stop timeout" }
	eof { abort_test "QEMU exited after background read" }
}
expect_prompt
send -- "fg\r"
expect {
	-re {JOB_CONTINUED} {}
	-re {\[PANIC\]} { abort_test "kernel panic foregrounding reader" }
	timeout { abort_test "foreground reader resume timeout" }
	eof { abort_test "QEMU exited foregrounding reader" }
}
after 100
send -- "job-input\r"
expect {
	-re {JOB_BACKGROUND_READ_OK} {}
	-re {JOB_CONTROL_FAIL[^\r\n]*} {
		abort_test "foregrounded terminal read failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in foregrounded reader" }
	timeout { abort_test "foregrounded reader timeout" }
	eof { abort_test "QEMU exited during foregrounded reader" }
}
expect_prompt

