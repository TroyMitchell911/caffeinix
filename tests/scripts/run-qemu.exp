#!/usr/bin/expect -f

proc abort_test {message} {
	puts stderr "QEMU selftest failed: $message"
	catch {close}
	exit 1
}

proc expect_prompt {} {
	expect {
		-re {\[PANIC\]} { abort_test "kernel panic before shell prompt" }
		-re {(^|\r?\n)# $} {}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited before shell prompt" }
	}
}

proc test_background_ioctl {mode ready result} {
	send -- "/bin/job-control-runtime $mode &\r"
	expect {
		-re $ready {}
		-re {JOB_CONTROL_FAIL[^\r\n]*} {
			abort_test "background terminal ioctl setup failed"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in background terminal ioctl"
		}
		timeout { abort_test "background terminal ioctl setup timeout" }
		eof { abort_test "QEMU exited during background terminal ioctl" }
	}
	after 250
	send -- "jobs\r"
	expect {
		-re "Stopped \\(tty output\\).*job-control-runtime $mode" {}
		-re "Running.*job-control-runtime $mode" {
			abort_test "background terminal ioctl did not stop"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic after background terminal ioctl"
		}
		timeout { abort_test "background terminal ioctl stop timeout" }
		eof { abort_test "QEMU exited after background terminal ioctl" }
	}
	expect_prompt
	send -- "fg\r"
	expect {
		-re {JOB_CONTINUED} {}
		-re {\[PANIC\]} {
			abort_test "kernel panic resuming terminal ioctl"
		}
		timeout { abort_test "terminal ioctl resume timeout" }
		eof { abort_test "QEMU exited resuming terminal ioctl" }
	}
	expect {
		-re $result {}
		-re {JOB_CONTROL_FAIL[^\r\n]*} {
			abort_test "restarted terminal ioctl failed"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in restarted terminal ioctl"
		}
		timeout { abort_test "restarted terminal ioctl timeout" }
		eof { abort_test "QEMU exited during restarted terminal ioctl" }
	}
	expect_prompt
}

proc expect_marker {marker description} {
	expect {
		-re "\\r?\\n$marker" {}
		-re {\\[PANIC\\]} { abort_test "kernel panic during $description" }
		timeout { abort_test "$description timeout" }
		eof { abort_test "QEMU exited during $description" }
	}
}

proc expect_editor_prompt {} {
	expect {
		-re {\x1b\[\?1049l# $} {}
		-re {(^|\r?\n)# $} {}
		-re {\[PANIC\]} { abort_test "kernel panic after vi exit" }
		timeout { abort_test "shell prompt after vi timeout" }
		eof { abort_test "QEMU exited with vi" }
	}
}

foreach variable {
	MAKE_COMMAND TEST_TOPDIR QEMU SBI_FIRMWARE ROOT_IMAGE FAT_IMAGE QEMU_LOG
	QEMU_CPUS QEMU_MEMORY
} {
	if {![info exists env($variable)] || $env($variable) eq ""} {
		puts stderr "missing environment variable: $variable"
		exit 1
	}
}

set timeout 60
if {[info exists env(QEMU_TIMEOUT)] && $env(QEMU_TIMEOUT) ne ""} {
	set timeout $env(QEMU_TIMEOUT)
}

log_file -noappend $env(QEMU_LOG)
set command [list \
	$env(MAKE_COMMAND) \
	--silent \
	--no-print-directory \
	-C $env(TEST_TOPDIR) \
	QEMU=$env(QEMU) \
	SBI_FIRMWARE=$env(SBI_FIRMWARE) \
	FS_IMG=$env(ROOT_IMAGE) \
	FAT_IMG=$env(FAT_IMAGE) \
	CPUS=$env(QEMU_CPUS) \
	MEMORY=$env(QEMU_MEMORY) \
	ROOT_BUS=virtio-mmio-bus.1 \
	FAT_BUS=virtio-mmio-bus.2 \
	NET_BACKEND=user \
	NET_OPTIONS=hostfwd=tcp:127.0.0.1:18082-:18082 \
	NET_BUS=virtio-mmio-bus.0 \
	QEMU_SNAPSHOT= \
	QEMU_EXTRA_OPTS= \
	QEMU_PREBUILT=1 \
	qemu]

spawn -noecho {*}$command

expect {
	-re {job control turned off} {
		abort_test "BusyBox ash disabled job control"
	}
	-re {\[PANIC\]} { abort_test "kernel panic before shell startup" }
	-re {\r?\n# $} {}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before shell startup" }
}

send -- "echo BUSYBOX_SHELL_OK\r"
expect {
	-re {\r?\nBUSYBOX_SHELL_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox shell" }
	timeout { abort_test "BusyBox shell command timeout" }
	eof { abort_test "QEMU exited in BusyBox shell" }
}
expect_prompt

send -- "/bin/exec-runtime\r"
expect {
	-re {\r?\nEXEC_SCRIPT_CHILD_OK} {}
	-re {EXEC_RUNTIME_FAIL[^\r\n]*} {
		abort_test "script interpreter test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in script test" }
	timeout { abort_test "script interpreter test timeout" }
	eof { abort_test "QEMU exited during script interpreter test" }
}
expect {
	-re {\r?\nEXEC_ERRNO_OK} {}
	-re {EXEC_RUNTIME_FAIL[^\r\n]*} {
		abort_test "exec errno test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in exec errno test" }
	timeout { abort_test "exec errno test timeout" }
	eof { abort_test "QEMU exited during exec errno test" }
}
expect {
	-re {\r?\nEXEC_SCRIPT_OK} {}
	-re {EXEC_RUNTIME_FAIL[^\r\n]*} {
		abort_test "script recursion test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in script recursion test" }
	timeout { abort_test "script recursion test timeout" }
	eof { abort_test "QEMU exited during script recursion test" }
}
expect_prompt

send -- "/bin/io-runtime\r"
foreach marker {
	VECTORED_IO_OK
	SENDFILE_OK
} {
	expect {
		-re "\\r?\\n$marker" {}
		-re {IO_RUNTIME_FAIL[^\r\n]*} {
			abort_test "vectored I/O test reported failure"
		}
		-re {\[PANIC\]} { abort_test "kernel panic in I/O test" }
		timeout { abort_test "vectored I/O test timeout" }
		eof { abort_test "QEMU exited during vectored I/O test" }
	}
}
