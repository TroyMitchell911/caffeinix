send -- "mkdir /tmp/bm && mount -t tmpfs tmpfs /tmp/bm && "
send -- "touch /tmp/bm/x && test -f /tmp/bm/x && "
send -- "umount /tmp/bm && rm -r /tmp/bm && "
send -- "echo BUSYBOX_TMPFS_MOUNT_OK\r"
expect_marker BUSYBOX_TMPFS_MOUNT_OK "BusyBox tmpfs mount commands"
expect_prompt

send -- "fat_device=; while read s t r; do "
send -- "test \"\$t\" = /mnt/fat && fat_device=/dev/\$s; "
send -- "done </proc/mounts; test -n \"\$fat_device\" && "
send -- "umount /mnt/fat && "
send -- "mount -t fat \"\$fat_device\" /mnt/fat && "
send -- "echo BUSYBOX_FAT_MOUNT_OK\r"
expect_marker BUSYBOX_FAT_MOUNT_OK "BusyBox FAT mount commands"
expect_prompt

send -- "touch /tmp/bb-admin && chmod 640 /tmp/bb-admin && "
send -- "test \"\$(stat -c %a /tmp/bb-admin)\" = 640 && "
send -- "chown 1234:56 /tmp/bb-admin && "
send -- "test \"\$(stat -c %u:%g /tmp/bb-admin)\" = 1234:56 && "
send -- "echo BUSYBOX_METADATA_OK\r"
expect_marker BUSYBOX_METADATA_OK "BusyBox file metadata"
expect_prompt

send -- "mkfifo /tmp/bb-admin-fifo && "
send -- "fallocate -l 4096 /tmp/bb-admin-space && "
send -- "df / >/dev/null && id >/dev/null && "
send -- "echo BUSYBOX_ADMIN_TOOLS_OK\r"
expect_marker BUSYBOX_ADMIN_TOOLS_OK "BusyBox file tools"
expect_prompt

send -- "rm /tmp/bb-admin /tmp/bb-admin-fifo /tmp/bb-admin-space && "
send -- "echo BUSYBOX_FILE_ADMIN_OK\r"
expect_marker BUSYBOX_FILE_ADMIN_OK "BusyBox file administration"
expect_prompt

send -- "case \"\$(ps)\" in *PID*) echo BUSYBOX_PS_OK;; esac\r"
expect_marker BUSYBOX_PS_OK "BusyBox ps"
expect_prompt

send -- "case \"\$(free)\" in *total*) echo BUSYBOX_FREE_OK;; esac\r"
expect_marker BUSYBOX_FREE_OK "BusyBox free"
expect_prompt

send -- "case \"\$(uptime)\" in *load*) echo BUSYBOX_UPTIME_OK;; esac\r"
expect_marker BUSYBOX_UPTIME_OK "BusyBox uptime"
expect_prompt

send -- "pidof sh >/dev/null && echo BUSYBOX_PIDOF_OK\r"
expect_marker BUSYBOX_PIDOF_OK "BusyBox pidof"
expect_prompt

send -- "case \"\$(top -b -n 1)\" in *PID*) echo BUSYBOX_TOP_OK;; esac\r"
expect_marker BUSYBOX_TOP_OK "BusyBox top"
expect_prompt

send -- "case \"\$(netstat -ant)\" in *Proto*) "
send -- "case \"\$(netstat -anu)\" in *Proto*) "
send -- "echo BUSYBOX_NETSTAT_OK;; esac;; esac\r"
expect_marker BUSYBOX_NETSTAT_OK "BusyBox netstat"
expect_prompt

send -- "/bin/job-control-runtime foreground\r"
expect {
	-re {JOB_FOREGROUND_READY} {}
	-re {JOB_CONTROL_FAIL[^\r\n]*} {
		abort_test "foreground job setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in foreground job" }
	timeout { abort_test "foreground job timeout" }
	eof { abort_test "QEMU exited during foreground job" }
}
after 100
send -- "\003"
expect_prompt
send -- "echo JOB_FOREGROUND_STATUS=\$?\r"
expect {
	-re {\r?\nJOB_FOREGROUND_STATUS=130} {}
	-re {\[PANIC\]} { abort_test "kernel panic after foreground Ctrl-C" }
	timeout { abort_test "foreground Ctrl-C status timeout" }
	eof { abort_test "QEMU exited after foreground Ctrl-C" }
}
expect_prompt

send -- "/bin/job-control-runtime stop\r"
expect {
	-re {JOB_STOP_READY} {}
	-re {JOB_CONTROL_FAIL[^\r\n]*} {
		abort_test "stoppable job setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic before foreground stop" }
	timeout { abort_test "stoppable job timeout" }
	eof { abort_test "QEMU exited before foreground stop" }
}
after 100
send -- "\032"
expect {
	-re {Stopped[^\r\n]*job-control-runtime stop} {}
	-re {\[PANIC\]} { abort_test "kernel panic after foreground stop" }
	timeout { abort_test "foreground stop report timeout" }
	eof { abort_test "QEMU exited after foreground stop" }
}
expect_prompt
send -- "jobs\r"
expect {
	-re {Stopped[^\r\n]*job-control-runtime stop} {}
	-re {\[PANIC\]} { abort_test "kernel panic while listing stopped job" }
	timeout { abort_test "stopped jobs listing timeout" }
	eof { abort_test "QEMU exited while listing stopped job" }
}
expect_prompt
send -- "echo JOB_STOPPED_OK\r"
expect -re {\r?\nJOB_STOPPED_OK}
expect_prompt
send -- "bg\r"
expect {
	-re {JOB_CONTINUED} {}
	-re {\[PANIC\]} { abort_test "kernel panic while resuming background job" }
	timeout { abort_test "background resume timeout" }
	eof { abort_test "QEMU exited while resuming background job" }
}
expect_prompt
send -- "jobs\r"
expect {
	-re {Running[^\r\n]*job-control-runtime stop} {}
	-re {\[PANIC\]} { abort_test "kernel panic while listing running job" }
	timeout { abort_test "running jobs listing timeout" }
	eof { abort_test "QEMU exited while listing running job" }
}
expect_prompt
send -- "echo JOB_BACKGROUND_OK\r"
expect -re {\r?\nJOB_BACKGROUND_OK}
expect_prompt
