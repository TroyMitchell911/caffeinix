	-re {TTY_SIGNAL_FLUSH_OK} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "TTY signal flush failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in TTY signal flush" }
	timeout { abort_test "TTY signal flush timeout" }
	eof { abort_test "QEMU exited during TTY signal flush" }
}
