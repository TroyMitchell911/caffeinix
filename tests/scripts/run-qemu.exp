#!/usr/bin/expect -f

proc abort_test {message} {
	puts stderr "QEMU selftest failed: $message"
	catch {close}
	exit 1
}

proc expect_prompt {} {
	expect {
		-re {\[PANIC\]} { abort_test "kernel panic before shell prompt" }
		-re {(^|\r?\n)# $} {}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited before shell prompt" }
	}
}

foreach variable {
	MAKE_COMMAND TEST_TOPDIR QEMU SBI_FIRMWARE ROOT_IMAGE FAT_IMAGE QEMU_LOG
	QEMU_CPUS QEMU_MEMORY
} {
	if {![info exists env($variable)] || $env($variable) eq ""} {
		puts stderr "missing environment variable: $variable"
		exit 1
	}
}

set timeout 60
if {[info exists env(QEMU_TIMEOUT)] && $env(QEMU_TIMEOUT) ne ""} {
	set timeout $env(QEMU_TIMEOUT)
}

log_file -noappend $env(QEMU_LOG)
set command [list \
	$env(MAKE_COMMAND) \
	--silent \
	--no-print-directory \
	-C $env(TEST_TOPDIR) \
	QEMU=$env(QEMU) \
	SBI_FIRMWARE=$env(SBI_FIRMWARE) \
	FS_IMG=$env(ROOT_IMAGE) \
	FAT_IMG=$env(FAT_IMAGE) \
	CPUS=$env(QEMU_CPUS) \
	MEMORY=$env(QEMU_MEMORY) \
	ROOT_BUS=virtio-mmio-bus.1 \
	FAT_BUS=virtio-mmio-bus.2 \
	NET_BACKEND=user \
	NET_OPTIONS=hostfwd=tcp:127.0.0.1:18082-:18082 \
	NET_BUS=virtio-mmio-bus.0 \
	QEMU_SNAPSHOT= \
	QEMU_EXTRA_OPTS= \
	QEMU_PREBUILT=1 \
	qemu]

spawn -noecho {*}$command

expect {
	-re {\[PANIC\]} { abort_test "kernel panic before shell startup" }
	-re {\r?\n# $} {}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before shell startup" }
}

send -- "echo BUSYBOX_SHELL_OK\r"
expect {
	-re {\r?\nBUSYBOX_SHELL_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox shell" }
	timeout { abort_test "BusyBox shell command timeout" }
	eof { abort_test "QEMU exited in BusyBox shell" }
}
expect_prompt

send -- "/bin/network-runtime\r"
expect {
	-re {\r?\nNETWORK_RUNTIME_OK} {}
	-re {NETWORK_RUNTIME_FAIL[^\r\n]*} {
		abort_test "network runtime test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in network runtime test" }
	timeout { abort_test "network runtime test timeout" }
	eof { abort_test "QEMU exited during network runtime test" }
}
expect_prompt

send -- "/bin/pressure-runtime\r"
expect {
	-re {\r?\nPRESSURE_RUNTIME_OK} {}
	-re {PRESSURE_RUNTIME_FAIL[^\r\n]*} {
		abort_test "mixed pressure test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in mixed pressure test" }
	timeout { abort_test "mixed pressure test timeout" }
	eof { abort_test "QEMU exited during mixed pressure test" }
}
expect_prompt

send -- "/usr/bin/nc 10.0.2.2 18081\r"
send -- "tcp-request\r"
expect {
	-re {tcp-reply} {}
	-re {not found|applet not found|Bad system call} {
		abort_test "BusyBox nc is unavailable"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox nc" }
	timeout { abort_test "BusyBox nc timeout" }
	eof { abort_test "QEMU exited during BusyBox nc" }
}
expect_prompt
send -- "echo BUSYBOX_NC_OK\r"
expect {
	-re {\r?\nBUSYBOX_NC_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic after BusyBox nc" }
	timeout { abort_test "BusyBox nc marker timeout" }
	eof { abort_test "QEMU exited after BusyBox nc" }
}
expect_prompt

send -- "/usr/bin/wget -q -O /tmp/http.out "
send -- "http://10.0.2.2:18084/fixture && "
send -- "/bin/cat /tmp/http.out\r"
expect {
	-re {\r?\ncaffeinix-http} {}
	-re {not found|applet not found|Bad system call} {
		abort_test "BusyBox wget is unavailable"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox wget" }
	timeout { abort_test "BusyBox wget timeout" }
	eof { abort_test "QEMU exited during BusyBox wget" }
}
expect_prompt
send -- "echo BUSYBOX_WGET_OK\r"
expect {
	-re {\r?\nBUSYBOX_WGET_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic after BusyBox wget" }
	timeout { abort_test "BusyBox wget marker timeout" }
	eof { abort_test "QEMU exited after BusyBox wget" }
}
expect_prompt

send -- "/bin/scheduler-runtime\r"
expect {
	-re {\r?\nSCHED_RUNTIME_OK} {}
	-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "scheduler runtime test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in scheduler runtime test" }
	timeout { abort_test "scheduler runtime test timeout" }
	eof { abort_test "QEMU exited during scheduler runtime test" }
}
expect_prompt

send -- "/bin/scheduler-runtime tty-wait\r"
set ready_count 0
while {$ready_count < 8} {
	expect {
		-re {\r?\nSCHED_TTY_READY} { incr ready_count }
		-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
			abort_test "scheduler TTY wait setup failed"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic before scheduler TTY wait"
		}
		timeout { abort_test "scheduler TTY waiter ready timeout" }
		eof { abort_test "QEMU exited before scheduler TTY wait" }
	}
}
for {set index 0} {$index < 8} {incr index} {
	send -- "scheduler-wakeup-$index\r"
}
expect {
	-re {\r?\nSCHED_TTY_WAIT_OK} {}
	-re {SCHED_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "scheduler TTY wait test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in scheduler TTY wait" }
	timeout { abort_test "scheduler TTY wait completion timeout" }
	eof { abort_test "QEMU exited during scheduler TTY wait" }
}
expect_prompt

send -- "/bin/tty-runtime metadata\r"
expect {
	-re {\r?\nTTY_METADATA_OK} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "TTY metadata test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in TTY metadata test" }
	timeout { abort_test "TTY metadata test timeout" }
	eof { abort_test "QEMU exited during TTY metadata test" }
}
expect_prompt

send -- "/bin/tty-runtime nonblock\r"
expect {
	-re {\r?\nTTY_NONBLOCK_OK} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "nonblocking TTY test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in nonblocking TTY test" }
	timeout { abort_test "nonblocking TTY test timeout" }
	eof { abort_test "QEMU exited during nonblocking TTY test" }
}
expect_prompt

send -- "/bin/tty-runtime canonical\r"
expect {
	-re {\r?\nTTY_CANONICAL_READY} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "canonical TTY setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in canonical TTY test" }
	timeout { abort_test "canonical TTY ready timeout" }
	eof { abort_test "QEMU exited during canonical TTY test" }
}
after 250
send -- "abc\177d\r"
expect {
	-re {TTY_CANONICAL_OK} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "canonical TTY validation failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic after canonical input" }
	timeout { abort_test "canonical TTY completion timeout" }
	eof { abort_test "QEMU exited after canonical input" }
}
expect_prompt

send -- "/bin/tty-runtime raw\r"
expect {
	-re {\r?\nTTY_RAW_READY} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "raw TTY setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in raw TTY test" }
	timeout { abort_test "raw TTY ready timeout" }
	eof { abort_test "QEMU exited during raw TTY test" }
}
after 250
send -- "R\rX!"
expect {
	-re {TTY_RAW_OK} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "raw TTY validation failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic during raw input" }
	timeout { abort_test "raw TTY completion timeout" }
	eof { abort_test "QEMU exited during raw input" }
}
expect_prompt

send -- "/bin/tty-runtime long-output\r"
expect {
	-re {\r?\nTTY_LONG_BEGIN} {}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "long UART setup failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic before long UART output" }
	timeout { abort_test "long UART output start timeout" }
	eof { abort_test "QEMU exited before long UART output" }
}
expect {
	-re {([U]+)[\r\n]+TTY_LONG_END} {
		if {[string length $expect_out(1,string)] != 1024} {
			abort_test "long UART output length mismatch"
		}
	}
	-re {TTY_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "long UART write failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in long UART output" }
	timeout { abort_test "long UART output timeout" }
	eof { abort_test "QEMU exited during long UART output" }
}
expect_prompt

send -- "/bin/fs-runtime\r"
expect {
	-re {\r?\nFS_RUNTIME_OK} {}
	-re {FS_RUNTIME_FAIL=[^\r\n]*} {
		abort_test "guest runtime test reported failure"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in guest selftest" }
	timeout { abort_test "guest selftest timeout" }
	eof { abort_test "QEMU exited during guest selftest" }
}
expect_prompt

send -- "sync\r"
expect {
	-re {\[PANIC\]} { abort_test "kernel panic during sync" }
	-re {\r?\n# $} {}
	timeout { abort_test "sync timeout" }
	eof { abort_test "QEMU exited during sync" }
}

send -- "\001x"
expect {
	eof {}
	timeout { abort_test "QEMU exit timeout" }
}
