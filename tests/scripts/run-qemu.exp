expect {
	-re {\r?\nDYNAMIC_BUSYBOX_OK} {}
	-re {not found|Bad system call} {
		abort_test "dynamic BusyBox execution failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in dynamic BusyBox" }
	timeout { abort_test "dynamic BusyBox timeout" }
	eof { abort_test "QEMU exited during dynamic BusyBox" }
}
expect_prompt

send -- "/bin/mkdir /tmp/dyn-bb && "
send -- "/bin/echo dynamic-data > /tmp/dyn-bb/source\r"
expect_prompt

send -- "/bin/cp /tmp/dyn-bb/source /tmp/dyn-bb/copy && "
send -- "/bin/cat /tmp/dyn-bb/copy\r"
expect {
	-re {\r?\ndynamic-data} {}
	-re {not found|Bad system call} {
		abort_test "dynamic BusyBox applet test failed"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in dynamic BusyBox applet test"
	}
	timeout { abort_test "dynamic BusyBox applet test timeout" }
	eof { abort_test "QEMU exited during dynamic BusyBox applet test" }
}
expect_prompt

send -- "/bin/ls /tmp/dyn-bb\r"
expect {
	-re {\r?\n(source[[:space:]]+copy|copy[[:space:]]+source)} {}
	-re {not found|Bad system call} {
		abort_test "dynamic BusyBox ls failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in dynamic BusyBox ls" }
	timeout { abort_test "dynamic BusyBox ls timeout" }
	eof { abort_test "QEMU exited during dynamic BusyBox ls" }
}
