#!/usr/bin/expect -f

proc abort_test {message} {
	puts stderr "QEMU selftest failed: $message"
	catch {close}
	exit 1
}

proc expect_prompt {} {
	expect {
		-re {\[PANIC\]} { abort_test "kernel panic before shell prompt" }
		-re {(^|\r?\n)# $} {}
		timeout { abort_test "shell prompt timeout" }
		eof { abort_test "QEMU exited before shell prompt" }
	}
}

foreach variable {
	MAKE_COMMAND TEST_TOPDIR QEMU SBI_FIRMWARE ROOT_IMAGE FAT_IMAGE QEMU_LOG
	QEMU_CPUS QEMU_MEMORY
} {
	if {![info exists env($variable)] || $env($variable) eq ""} {
		puts stderr "missing environment variable: $variable"
		exit 1
	}
}

set timeout 60
if {[info exists env(QEMU_TIMEOUT)] && $env(QEMU_TIMEOUT) ne ""} {
	set timeout $env(QEMU_TIMEOUT)
}

log_file -noappend $env(QEMU_LOG)
set command [list \
	$env(MAKE_COMMAND) \
	--silent \
	--no-print-directory \
	-C $env(TEST_TOPDIR) \
	QEMU=$env(QEMU) \
	SBI_FIRMWARE=$env(SBI_FIRMWARE) \
	FS_IMG=$env(ROOT_IMAGE) \
	FAT_IMG=$env(FAT_IMAGE) \
	CPUS=$env(QEMU_CPUS) \
	MEMORY=$env(QEMU_MEMORY) \
	ROOT_BUS=virtio-mmio-bus.1 \
	FAT_BUS=virtio-mmio-bus.2 \
	NET_BACKEND=user \
	NET_OPTIONS=hostfwd=tcp:127.0.0.1:18082-:18082 \
	NET_BUS=virtio-mmio-bus.0 \
	QEMU_SNAPSHOT= \
	QEMU_EXTRA_OPTS= \
	QEMU_PREBUILT=1 \
	qemu]

spawn -noecho {*}$command

expect {
	-re {\[PANIC\]} { abort_test "kernel panic before shell startup" }
	-re {\r?\n# $} {}
	timeout { abort_test "shell prompt timeout" }
	eof { abort_test "QEMU exited before shell startup" }
}

send -- "echo BUSYBOX_SHELL_OK\r"
expect {
	-re {\r?\nBUSYBOX_SHELL_OK} {}
	-re {\[PANIC\]} { abort_test "kernel panic in BusyBox shell" }
	timeout { abort_test "BusyBox shell command timeout" }
	eof { abort_test "QEMU exited in BusyBox shell" }
}
expect_prompt

send -- "/bin/dynamic-hello\r"
expect {
	-re {\r?\nDYNAMIC_HELLO_OK} {}
	-re {DYNAMIC_RUNTIME_FAIL|not found|Bad system call} {
		abort_test "dynamic musl hello failed"
	}
	-re {\[PANIC\]} { abort_test "kernel panic in dynamic musl hello" }
	timeout { abort_test "dynamic musl hello timeout" }
	eof { abort_test "QEMU exited during dynamic musl hello" }
}
expect_prompt

send -- "/bin/random-runtime\r"
expect {
	-re {\r?\nRANDOM_RUNTIME_OK} {}
	-re {RANDOM_RUNTIME_FAIL[^\r\n]*} {
		abort_test "userspace random test reported failure"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in userspace random test"
	}
	timeout { abort_test "userspace random test timeout" }
	eof { abort_test "QEMU exited during userspace random test" }
}
expect_prompt

send -- "/bin/aslr-runtime\r"
expect {
	-re {\r?\nASLR_RUNTIME_OK} {}
	-re {ASLR_RUNTIME_FAIL[^\r\n]*} {
		abort_test "address randomization test reported failure"
	}
	-re {\[PANIC\]} {
		abort_test "kernel panic in address randomization test"
	}
	timeout { abort_test "address randomization test timeout" }
	eof { abort_test "QEMU exited during address randomization test" }
}
expect_prompt

send -- "/bin/dynamic-runtime\r"
foreach marker {
	DYNAMIC_CONSTRUCTOR_OK
	DYNAMIC_NEEDED_OK
	DYNAMIC_TLS_OK
	DYNAMIC_DLOPEN_OK
	DYNAMIC_PREAD_OK
	DYNAMIC_RELRO_OK
	DYNAMIC_EXEC_OK
	DYNAMIC_EXEC_PRESSURE_OK
	DYNAMIC_RUNTIME_OK
	DYNAMIC_DESTRUCTOR_OK
} {
	expect {
		-re "\\r?\\n$marker" {}
		-re {DYNAMIC_RUNTIME_FAIL[^\r\n]*} {
			abort_test "dynamic musl runtime test failed"
		}
		-re {\[PANIC\]} {
			abort_test "kernel panic in dynamic musl runtime test"
		}
		timeout { abort_test "dynamic musl runtime test timeout" }
		eof { abort_test "QEMU exited during dynamic musl runtime test" }
	}
}
expect_prompt

