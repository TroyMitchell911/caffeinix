LWEXT4_CONFIG_CFLAGS := -DCONFIG_USE_DEFAULT_CFG=1
LWEXT4_CONFIG_CFLAGS += -DCONFIG_EXT_FEATURE_SET_LVL=4
LWEXT4_CONFIG_CFLAGS += -DCONFIG_HAVE_OWN_ERRNO=1
LWEXT4_CONFIG_CFLAGS += -DCONFIG_HAVE_OWN_OFLAGS=1
LWEXT4_CONFIG_CFLAGS += -DCONFIG_DEBUG_PRINTF=0
LWEXT4_CONFIG_CFLAGS += -DCONFIG_DEBUG_ASSERT=0
LWEXT4_CONFIG_CFLAGS += -DCONFIG_XATTR_ENABLE=1
LWEXT4_CONFIG_CFLAGS += -DCONFIG_BLOCK_DEV_CACHE_SIZE=4
LWEXT4_CONFIG_CFLAGS += -DCONFIG_EXT4_BLOCKDEVS_COUNT=1
LWEXT4_CONFIG_CFLAGS += -DCONFIG_EXT4_MOUNTPOINTS_COUNT=1
