CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_LS=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_RM=y
CONFIG_STAT=y
CONFIG_SYNC=y
CONFIG_TOUCH=y
CONFIG_NC=y
CONFIG_WGET=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_INTERNAL_GLOB=y
