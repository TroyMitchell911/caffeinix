# Recursive object aggregation. Child builds own source dependencies; this
# layer orders their relocatable outputs before linking the parent built-in.o.
PHONY := __build
__build:

obj-y :=
subdir-y :=
EXTRA_CFLAGS :=

# Tell the top-level Makefile that it is being parsed by the recursive build
# engine, so it does not add the top-level bootstrap dependency again.
KBUILD_RECURSIVE := 1

# Each recursive invocation runs in the directory whose obj-y it consumes.
include Makefile

# A trailing slash denotes a child directory, not a local object.
__subdir-y	:= $(patsubst %/,%,$(filter %/, $(obj-y)))

subdir-y	+= $(__subdir-y)

subdir_objs := $(foreach f,$(subdir-y),$(f)/built-in.o)

cur_objs := $(filter-out %/, $(obj-y))

# Compiler-generated header dependencies are optional on the first build.
dep_files := $(foreach f,$(cur_objs),.$(f).d)

dep_files := $(wildcard $(dep_files))

ifneq ($(dep_files),)
  include $(dep_files)
endif

# Recursive objects must always be reconsidered because their real source
# dependencies live in the child make invocation.
PHONY += $(subdir_objs)

__build : built-in.o

# Build the object as the recursive target itself.  This makes the producer of
# each subdirectory built-in.o explicit and keeps parallel builds ordered.
$(subdir_objs): %/built-in.o:
	@echo subdir-y = $*
	$(MAKE) -C $* -f $(TOPDIR)/Makefile.build

# Preserve relocation records for the final top-level kernel link.
built-in.o : $(cur_objs) $(subdir_objs)
	$(LD) $(LDFLAGS) -r -o $@ $^

dep_file = .$@.d

%.o : %.c
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $(CFLAGS_$@) -Wp,-MD,$(dep_file) -c -o $@ $<

%.o : %.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $(CFLAGS_$@) -Wp,-MD,$(dep_file) -c -o $@ $<

.PHONY : $(PHONY)
